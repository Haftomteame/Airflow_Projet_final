POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
APP_DB_URL=postgresql://airflow:airflow@postgres/belgian_companies
HDFS_URL=http://namenode:9870
HDFS_USER=hdfs
MONGODB_URI=mongodb://airflow:airflow@mongodb:27017/?authSource=admin
MONGODB_DB=belgian_companies
MONGODB_METADATA_COLLECTION=scrape_metadata
MONGODB_HOST_PORT=27017
PROXY_LIST=
PROXY_LIST_URL=https://api.proxyscrape.com/v2/?request=displayproxies&protocol=http&timeout=5000&country=all&ssl=all&anonymity=all
# Utiliser le cache local (évite ProxyScrape à chaque tâche Airflow)
PROXY_USE_CACHE_FILE=true
PROXY_CACHE_IGNORE_TTL=true
PROXY_AUTO_FETCH=false
# Rafraîchir le cache : python scripts/refresh_proxies.py
PROXY_FETCH_PROTOCOLS=http,socks5,socks4
PROXY_FETCH_TIMEOUT_MS=5000
PROXY_VALIDATE=true
PROXY_VALIDATE_URLS=http://httpbin.org/ip,http://www.google.com/generate_204,https://httpbin.org/get
PROXY_VALIDATE_TIMEOUT=10
PROXY_VALIDATE_MAX=0
PROXY_VALIDATE_WORKERS=60
PROXY_LIST_FILE=
PROXY_CACHE_FILE=/opt/airflow/data/proxies_active.txt
PROXY_CACHE_TTL_HOURS=24
# Rotation : Tor en priorité pour KBO HTTPS, puis HTTP, puis SOCKS5h
PROXY_USE_TOR=true
PROXY_HTTPS_HTTP_ONLY=false
PROXY_BLACKLIST_ON_RATE_LIMIT=false
PROXY_MAX_ROTATIONS=50
PROXY_RETRY_DELAY=0.5
# Tor (scraping KBO + dag spam_kbo_tor_taskflow) — démarrer tor1/tor2/tor3
TOR_PROXIES=socks5h://tor1:9050,socks5h://tor2:9050,socks5h://tor3:9050
KBO_BASE_URL=https://kbopub.economie.fgov.be/kbopub/toonondernemingps.html
MONITEUR_BASE_URL=https://www.ejustice.just.fgov.be/cgi_tsv/list.pl
BNB_BASE_URL=https://consult.cbso.nbb.be/
KBO_DATA_PATH=/kbo_data
KBO_IMPORT_LIMIT=1000
# Heartbeat pendant COPY (évite zombie Celery sur import long)
KBO_IMPORT_HEARTBEAT_SEC=20
AIRFLOW_TASK_HEARTBEAT_SEC=30
# Pipelines trigger (attente longue) : éviter zombie / state mismatch
AIRFLOW_TASK_HEARTBEAT_TIMEOUT=14400
TRIGGER_EXECUTION_TIMEOUT_HOURS=24
KBO_SCRAPE_QUEUE_LIMIT=500
AIRFLOW_UID=50000
AIRFLOW_SECRET_KEY=belgian_companies_api_secret_dev
#AIRFLOW_JWT_SECRET=belgian_companies_jwt_secret_dev_key_32chars
AIRFLOW_JWT_SECRET=1MAMfo9cWRQ8aPMD8OfNnR4iMaWJl8dFQJ7yDk9Jnm8
AIRFLOW_JWT_EXPIRATION=14400
DASHBOARD_REFRESH_SECONDS=30
AIRFLOW_UI_URL=http://localhost:8080
# Ports HDFS exposés sur l'hôte (éviter conflit avec anciens conteneurs / MinIO)
HDFS_WEB_HOST_PORT=19870
HDFS_RPC_HOST_PORT=19000
HDFS_UI_URL=http://localhost:19870
AIRFLOW_FERNET_KEY=46BKJoQYlN9cN2F44sOp6bAFGzhSokcTyHWUA5KpyEc=
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin
